<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(SolutionDir)CommonPackageHandling.targets" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lz.Runner</RootNamespace>

    <!-- Global tool packaging. Owns the `lz` command. When installed, it
         loads the highest-versioned Lz.Cli.*.nupkg it can find via the
         NuGet.Config walk for the current directory, extracts it to
         %LOCALAPPDATA%\lz-runner\cache\<version>+<length>-<mtime>\ (one
         entry per distinct nupkg, so working copies never share one), and
         invokes `dotnet <extracted-Lz.Cli.dll> <args>`. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lz</ToolCommandName>
    <PackageId>Lz.Runner</PackageId>
    <Version>$(LzRunnerVersion)</Version>
    <Description>Lz dispatcher — resolves the correct Lz.Cli version from the in-scope NuGet.Config and invokes it. Installs as `lz`.</Description>

    <!-- MIT, matching the sibling LazyMagic repo. The full text is LICENSE.txt at
         the repo root, which is what GitHub reads; the SPDX expression here is what
         puts a license on the package itself. Use the expression rather than
         PackageLicenseFile: the two are mutually exclusive, and for a stock license
         the identifier is what NuGet recommends. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Insight Sciences Corporation</Copyright>
    <Authors>Tim May, Thomas May</Authors>
    <Company>Insight Sciences Corporation</Company>
    <RepositoryUrl>https://github.com/LazyMagicOrg/LzRunner</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- No AssemblyMetadata for BuildOriginPackages or DefaultCliVersion.
       After the LzRunner/Lz repo split, the runner has no inherent
       knowledge of where Lz.Cli lives or what version exists. If the
       NuGet.Config walk doesn't lead to an Lz.Cli.*.nupkg, the runner
       errors out (see Program.cs). -->

</Project>
